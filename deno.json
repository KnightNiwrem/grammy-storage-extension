{
  "name": "@grammyjs/storage-extended",
  "version": "0.1.0",
  "license": "MIT",
  "lock": false,
  "exports": {
    ".": "./src/mod.ts"
  },
  "tasks": {
    "test": "deno test --allow-env --allow-import=cdn.jsdelivr.net,jsr.io,cdn.skypack.dev",
    "check": "deno check --allow-import=cdn.jsdelivr.net,jsr.io,cdn.skypack.dev src/mod.ts test/ examples/",
    "lint": "deno lint",
    "fmt:check": "deno fmt --check",
    "publish:dry": "deno publish --dry-run --allow-dirty"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/encoding": "jsr:@std/encoding@1",
    "grammy": "https://cdn.jsdelivr.net/gh/grammyjs/grammY@^1.42.0/src/mod.ts"
  },
  "fmt": {
    "exclude": [
      "spec.md"
    ]
  }
}
